# Calliad hub — env template. Copy to .env.local and fill in. .env.local is gitignored.

# ── Anthropic (T2/T3 brain) ────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
SPEND_CAP_USD_MONTH=10                 # soft in-app monthly cap; prepaid credits are the hard cap

# ── Supabase ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...   # Supabase "publishable key" (was: anon)
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...            # Supabase "secret key" (was: service_role) — server only

# ── Hub secrets (generate with: openssl rand -hex 24) ─────────────────────
ADMIN_SECRET=                          # x-admin-secret header for /api/admin/*
WEBHOOK_SECRET=                        # per-source secret for /api/webhook/:source
CRON_SECRET=                           # Authorization: Bearer / x-cron-secret for /api/cron/*

# ── Web push (generate with: npx web-push generate-vapid-keys) ────────────
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ── Misc ──────────────────────────────────────────────────────────────────
TZ_DEFAULT=America/New_York

# ── Phase 1 — Gmail + iCloud calendar ───────────────────────────────────
NEXT_PUBLIC_APP_URL=https://calliad-psi.vercel.app
GOOGLE_CLIENT_ID=            # Google Cloud OAuth 2.0 client (scope: gmail.readonly)
GOOGLE_CLIENT_SECRET=
# iCloud calendar connects in-app (Apple ID + app-specific password) — no env var.

# ── Later phases (not needed yet) ───────────────────────────────────────
GOOGLE_AI_KEY=              # aistudio.google.com/apikey — T1 cheap classification
# GROQ_API_KEY=              # Whisper STT (voice, Phase 3)
